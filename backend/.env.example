# ==========================================================================
# Chaves de acesso do conector de seguidores.
# Copie este arquivo para ".env" e preencha. NUNCA suba o .env para o GitHub.
# ==========================================================================

# Porta e origem permitida (endereço onde o painel está publicado).
PORT=3000
# Troque "*" pelo endereço do seu painel, ex.: https://seu-usuario.github.io
ALLOW_ORIGIN=*

# --------------------------------------------------------------------------
# META (Instagram + Facebook) — uma única "chave" cobre as duas redes.
# --------------------------------------------------------------------------
# Token de acesso de longa duração (System User token é o ideal).
META_TOKEN=
# Versão da Graph API (deixe assim se não souber).
META_GRAPH_VERSION=v21.0
# De qual conta/página vem cada @usuário (IDs numéricos das contas da campanha).
# Ex.: {"facebook:sidneycruzsp":"1234567890","instagram:sidneycruz":"178414..."}
META_MAP={}
# (Opcional) ID da conta Instagram da campanha, para consultar seguidores de
# perfis públicos business/creator via "Business Discovery".
META_IG_SELF_ID=

# --------------------------------------------------------------------------
# TIKTOK — a conta da campanha precisa fazer login no app uma vez.
# --------------------------------------------------------------------------
# Token de acesso da conta da campanha.
TIKTOK_TOKEN=
# (Opcional) Token por @usuário, se houver mais de uma conta.
# Ex.: {"tiktok:sidneycruz":"act.exemplo..."}
TIKTOK_MAP={}
